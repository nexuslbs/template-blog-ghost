# Example instance B env: a SECOND theme. The shipped lock declares `casper`
# and `source`, so instance B selects `source` while instance A selects
# `casper`. The lock is the documented theme manifest; no theme file is edited.
# Copy to instances/b/.env (gitignored):
#   ENV_FILE=instances/b/.env scripts/up.sh
#   ENV_FILE=instances/b/.env scripts/bootstrap.sh
#   ENV_FILE=instances/b/.env scripts/apply.sh
#   ENV_FILE=instances/b/.env scripts/verify.sh
COMPOSE_PROJECT_NAME=template-blog-ghost-b
RUNTIME_DIR=instances/b/runtime
GHOST_URL=http://localhost:2369
GHOST_BIND_ADDR=127.0.0.1
GHOST_PORT=2369
GHOST_MAIL_TRANSPORT=Direct
GHOST_MAIL_HOST=
GHOST_MAIL_PORT=587
GHOST_MAIL_USER=
GHOST_MAIL_PASSWORD=
GHOST_MAIL_FROM=
MYSQL_ROOT_PASSWORD_FILE=./secrets/mysql_root_password.txt
GHOST_ADMIN_NAME=Owner
GHOST_ADMIN_EMAIL=owner-b@example.com
GHOST_ADMIN_PASSWORD=change-me-to-a-long-unique-password
GHOST_BLOG_TITLE=Ghost Instance B
GHOST_INTEGRATION_NAME=dsh-template-b
GHOST_THEME_NAME=source
