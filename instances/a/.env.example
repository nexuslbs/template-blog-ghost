# Example instance A env: theme `casper` (the theme declared in the shipped
# lock). Copy to instances/a/.env (gitignored) and run with:
#   ENV_FILE=instances/a/.env scripts/up.sh
#   ENV_FILE=instances/a/.env scripts/bootstrap.sh
#   ENV_FILE=instances/a/.env scripts/apply.sh
#   ENV_FILE=instances/a/.env scripts/verify.sh
COMPOSE_PROJECT_NAME=template-blog-ghost-a
RUNTIME_DIR=instances/a/runtime
GHOST_URL=http://localhost:2368
GHOST_BIND_ADDR=127.0.0.1
GHOST_PORT=2368
GHOST_MAIL_TRANSPORT=Direct
GHOST_MAIL_HOST=
GHOST_MAIL_PORT=587
GHOST_MAIL_USER=
GHOST_MAIL_PASSWORD=
GHOST_MAIL_FROM=
MYSQL_ROOT_PASSWORD_FILE=./secrets/mysql_root_password.txt
GHOST_ADMIN_NAME=Owner
GHOST_ADMIN_EMAIL=owner-a@example.com
GHOST_ADMIN_PASSWORD=change-me-to-a-long-unique-password
GHOST_BLOG_TITLE=Ghost Instance A
GHOST_INTEGRATION_NAME=dsh-template-a
GHOST_THEME_NAME=casper
