# Copy to .env and edit. .env is gitignored; this file holds placeholders only.
# Every knob the shipped compose file reads is listed here. The GHOST_MAIL_*
# block below is the exception: only GHOST_MAIL_TRANSPORT is read today; the
# rest document the values to wire in when you extend docker-compose.yml with a
# mail relay (see docs/RUNBOOK.md section 2).

# --- Compose project -------------------------------------------------------
# Prefix for container/volume/network names. One project per stack.
COMPOSE_PROJECT_NAME=template-blog-ghost

# --- Public address --------------------------------------------------------
# The URL Ghost serves and uses to build absolute links. No trailing slash.
# Sandbox:  http://172.18.0.1:2368   (reachable from the docker bridge)
# Prod:     https://blog.example.com (behind a TLS terminator)
GHOST_URL=http://localhost:2368
# Host interface and port the Ghost container is published on.
# Use 127.0.0.1 when a reverse proxy terminates TLS on the same host.
GHOST_BIND_ADDR=127.0.0.1
GHOST_PORT=2368

# --- Mail ------------------------------------------------------------------
# Read by docker-compose.yml: mail__transport.
# Direct = no external mail (fine for a sandbox; NO password reset mail).
# SMTP   = the production choice; the SMTP knobs below are NOT read by the
#          shipped compose file, they are the values to add as mail__options__*
#          and mail__from when you extend it with an SMTP relay.
GHOST_MAIL_TRANSPORT=Direct
GHOST_MAIL_HOST=
GHOST_MAIL_PORT=587
GHOST_MAIL_USER=
GHOST_MAIL_PASSWORD=
GHOST_MAIL_FROM=

# --- Database secret (file, never inlined) ---------------------------------
# Path to the file that holds the MySQL root password. Relative paths resolve
# against this directory. Create it before `make up`:
#   mkdir -p secrets && openssl rand -base64 24 > secrets/mysql_root_password.txt
MYSQL_ROOT_PASSWORD_FILE=./secrets/mysql_root_password.txt

# --- Bootstrap owner (consumed by scripts/bootstrap.sh only) ---------------
# This is the first Ghost owner account, created through the official setup API.
# It is NOT read by Ghost itself.
GHOST_ADMIN_NAME=Owner
GHOST_ADMIN_EMAIL=owner@example.com
GHOST_ADMIN_PASSWORD=change-me-to-a-long-unique-password
GHOST_BLOG_TITLE=My Ghost Blog
GHOST_INTEGRATION_NAME=dsh-template

# --- Theme -----------------------------------------------------------------
# Name must match an entry in config/themes.lock.json.
GHOST_THEME_NAME=casper
