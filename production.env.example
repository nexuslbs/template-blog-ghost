# Production environment TEMPLATE. Copy to a production .env (never committed)
# on the production host. It is the SAME set of keys as .env.example: sandbox
# and production differ by CONFIG ONLY, never by code. A named human fills the
# real secret values from the operator secret store; nothing here is a secret.
#
# Differences from the sandbox .env (all values, no keys):
#   COMPOSE_PROJECT_NAME  a production project name, never omni-stack
#   GHOST_URL             the real public https URL
#   GHOST_BIND_ADDR       the interface the reverse proxy reaches
#   GHOST_MAIL_*          the real SMTP relay (see docs/RUNBOOK.md section 2)
#   the secrets           real values from the operator secret store

# --- Compose project -------------------------------------------------------
COMPOSE_PROJECT_NAME=template-blog-ghost-prod

# --- Public address --------------------------------------------------------
GHOST_URL=https://blog.example.com
GHOST_BIND_ADDR=127.0.0.1
GHOST_PORT=2368

# --- Mail ------------------------------------------------------------------
GHOST_MAIL_TRANSPORT=SMTP
GHOST_MAIL_HOST=smtp.example.com
GHOST_MAIL_PORT=587
GHOST_MAIL_USER=blog@example.com
GHOST_MAIL_PASSWORD=REPLACE_FROM_SECRET_STORE
GHOST_MAIL_FROM=blog@example.com

# --- Database secret (file, never inlined) ---------------------------------
MYSQL_ROOT_PASSWORD_FILE=./secrets/mysql_root_password.txt

# --- Bootstrap owner (consumed by scripts/bootstrap.sh only) ---------------
GHOST_ADMIN_NAME=Owner
GHOST_ADMIN_EMAIL=owner@example.com
GHOST_ADMIN_PASSWORD=REPLACE_FROM_SECRET_STORE
GHOST_BLOG_TITLE=Example Blog
GHOST_INTEGRATION_NAME=dsh-template

# --- Theme -----------------------------------------------------------------
GHOST_THEME_NAME=casper
